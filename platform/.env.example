# OpenClaw Hive Platform 配置
# 复制此文件为 .env 并修改

# ===== 路径配置 =====
# obsutil 可执行文件路径（必须是绝对路径）
OBSUTIL_PATH=/home/nianzuzheng/project/openclaw-hive/platform/obsutil/obsutil

# OBS 桶地址
OBS_BUCKET=obs://rl-agentdata

# 离线工具本地缓存根（输出模块离线函数：show_lx_summary / task_traj / task_status）
# 绝对路径直接用；相对路径基于 platform/ 解析；留空则默认 platform/output_cache。
# 下载布局：output_cache/<batch>/<task>/...（保留 batch 段，避免同名 task 撞目录）
OUTPUT_CACHE=./output_cache

# 以下路径留空则自动基于 HIVE_ROOT 推导，一般不需要改
# HIVE_ROOT=           # 默认自动检测（config.py 所在位置向上推导）
# CONFIG_TEMPLATE=     # 默认 {HIVE_ROOT}/platform/settings/config.yaml
# SETTINGS_DIR=        # 默认 {HIVE_ROOT}/platform/settings
# HARNESS_DIR=         # Harness 配置目录的全局根，默认同 SETTINGS_DIR。
#                      # 每个方案的相对路径存在 harness_configs.harness_dir 列，
#                      # 实际路径 = HARNESS_DIR + 该相对路径（如 harness/openclaw/harness-5）。
#                      # 换机器或整体迁移配置目录时只需改这里。
# DB_PATH=             # 默认 {HIVE_ROOT}/platform/platform.db
#
# settings/ 目录下的配置文件使用 .example 机制：
#   config.yaml.example    → 复制为 config.yaml 并填入实际值
#   openclaw.json.example  → 复制为 openclaw.json 并填入 apiKey 等
#   user_proxy_model.json.example → 复制为 user_proxy_model.json
#   worker/config.yaml.example    → 复制为 worker/config.yaml（产物下载并发/限流）
# 首次启动时如果实际文件不存在，会自动从 .example 复制

# ===== 沙箱交付物预览 =====
# LibreOffice headless 可执行文件名或绝对路径，用于 pptx/docx/xlsx → PDF 预览。
# 找不到时 /api/artifacts/{id}/pdf 返回 503，其它格式（文本/图片/PDF/HTML）不受影响。
# 装 LibreOffice： ./run.sh soffice-install
# SOFFICE_PATH=soffice

# ===== 安全配置 =====
# JWT 签名密钥（生产环境务必修改为随机字符串）
SECRET_KEY=change-me-to-a-random-string

# Token 有效期（分钟），默认 24 小时
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== 初始管理员账号（首次启动自动创建） =====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ===== 对外 API（/openapi/v1）鉴权 =====
# 逗号分隔可配多个 key；调用方带 X-API-Key 请求头。
# 留空 = 该接口整体不可用（返回 503），不会退化成无鉴权。
PUBLIC_API_KEYS=

# ===== 队列调度配置 =====
# 全局沙箱上限已取消：队列放行只看本队列内的占用者数量。

# 全局并发上限：任何队列同时占用的任务数都不能超过它。
# 队列实际并发 = min(QUEUE_MAX_CONCURRENT, 该队列自己的 max_concurrent)。
# 默认 10；设为 1 则所有队列严格串行。改完需重启后端。
QUEUE_MAX_CONCURRENT=10
