# API Key 自动申请配置（示例，复制为 key_gen.yaml 后填入真实 token）
# 创建实例时，若填写了 invite_code 且未手动指定 api_key，会调用此处配置的接口自动申请。
# 前端"新建KEY"按钮走 POST /api/generate-api-key，同样复用这里的配置。
#
# 支持多个申请服务：按传入的 base_url 匹配 endpoints 里的某一条规则。
# 不同服务可有不同的 HTTP 方法、endpoint 路径、是否携带 token、以及返回字段名。
# 传入的 base_url 命中某条规则的 match 前缀时用该规则；都不命中时用 default。

# 各申请服务的规则。match 为 base_url 的匹配前缀（host:port 或完整前缀均可）。
# method: GET 走 query 参数；POST 走 JSON body。
endpoints:
  # 服务 8082：GET /api/invite，query 参数，需要 token，返回字段 api_key
  - match: "1.95.199.64:8082"
    method: "GET"
    endpoint: "/api/invite"
    params:
      token: "REPLACE_WITH_REAL_TOKEN"
    response_key_field: "api_key"

  # 服务 8084：POST /api/invite，JSON body，不需要 token，返回字段 key
  - match: "1.95.199.64:8084"
    method: "POST"
    endpoint: "/api/invite"
    params: {}
    response_key_field: "key"

# 兜底规则：传入的 base_url 未命中上面任何 match 时使用。
# base_url: "*" 表示沿用调用方传入的 base_url。
default:
  base_url: "*"
  method: "POST"
  endpoint: "/api/invite"
  params: {}
  response_key_field: "key"

# 请求超时（秒）
timeout: 15
