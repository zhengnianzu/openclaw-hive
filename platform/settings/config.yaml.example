# ==================== 全局配置 ====================
global:
  # 控制面服务地址，SDK 通过此地址与控制面通信
  controlplane_base_url: http://192.168.20.109:30081
  # API 认证密钥，用于 SDK 与控制面之间的身份校验
  api_key: "omni-env-default-api-key"


# ==================== 沙箱环境配置 ====================
# 定义不同架构/加速器类型的沙箱配置，每种配置对应一种运行环境:x86 CPU / ARM CPU / NPU / windows
# platform 端 build_make_config 默认使用 x86_cpu
sandbox:
  x86_cpu:
    architecture: x86           # CPU 架构: x86 / arm64
    accelerator: null           # 加速器类型: null / npu / gpu
    ttl_seconds: 3600           # 沙箱生存时间（秒），超时后自动回收
    wait_timeout_seconds: 300   # 等待沙箱就绪的超时时间（秒）
    sandbox:
      image: xxx                # 镜像地址，创建任务表单会覆盖
      env:
        - name: PIP_INDEX_URL
          value: https://mirrors.tools.huawei.com/pypi/simple
        - name: PIP_TRUSTED_HOST
          value: mirrors.tools.huawei.com
        - name: ADAPTOR_NAME
          value: deep_diver
        - name: ADAPTOR_PORT
          value: "8008"
        - name: NODE_TLS_REJECT_UNAUTHORIZED
          value: "0"
        - name: SERPER_API_KEY
          value: your-api-key
      resources:
        cpu_request: "1"
        cpu_limit: "1.5"
        memory_request: "4Gi"
        memory_limit: "4Gi"


s3:
  s3_uploader_script: /home/ma-user/obsutil/obsutil
  s3_download_script: /home/ma-user/obsutil/obsutil
  bucket_name: "obs://rl-agentdata"


# 沙箱 ID 前缀，用于 Pod 命名和批量清理（run_clear.py 也读它）
# 创建任务表单里的 task_name 会写到这里
sandbox_id_prefix: xxx


run_config:
  harness_type: openclaw        # openclaw / hermes / claude-code
  start_index: 0                # 开始执行任务的索引号
  total_num: 0                  # 任务总数, 0 表示不限
  concurrent_num: 100           # 并发数，claude 100~150
  sandbox:
    result_log: "run.log"
    openclaw_local_config_file: "uploads/openclaw.json"
    user_proxy_model_local_file: "uploads/user_proxy_model.json"
    openclaw_start_timeout: 80  # openclaw 镜像 > 0.0.6 时设 >60
  task:
    task_input_path: "uploads/configs"
    task_output_path: "outputs"
    task_complete_record: "complete.jsonl"
    task_failed_record: "failed.jsonl"
    task_download_path: "downloads"
    main_code_tar: "uploads/openclaw-task.tar"
    main_code_dir: ""           # 非空时自动打包替代 main_code_tar
    main_python_file: "harness_automation.py"
  obs:
    download_timeout: 1200
    upload_timeout: 900
    traj_save_bucket: "obs://rl-agentdata"
    # traj_save_path 结尾不要加 "/"，否则 OBS 路径会出现 "//"
    traj_save_path: "openclaw_trajs/traj_0522_webconfig"
    skill_download_path: "skills/260325/skill_localize/skills_library"
    user_config_download_path: "task_data/260520/web_configs"
    user_profile_download_path:
    agents_download_path: "task_data/260413_noenv/noenv_configs/agents"
    default_skills:
      - "find-skills"
      - "skill-scope"
