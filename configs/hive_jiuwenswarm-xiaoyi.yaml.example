# ==================== 全局配置 ====================
global:
  # 控制面服务地址，SDK 通过此地址与控制面通信
  controlplane_base_url: http://192.168.11.87:30081
  # API 认证密钥，用于 SDK 与控制面之间的身份校验
  api_key: "api-key"
  logger:
    name: env_sdk_client
    level: INFO
    dir: logs
    console: true
    file: true
    stream: stdout
    max_backup_count: 14
    encoding: utf-8
    format: "%(asctime)s|%(filename)s:%(lineno)d|%(funcName)s|%(process)d|%(thread)d|%(threadName)s|%(levelname)s|%(message)s"
    datefmt: "%Y-%m-%d %H:%M:%S"
    when: midnight
    interval: 1

# ==================== 沙箱环境配置 ====================
# 定义不同架构/加速器类型的沙箱配置，每种配置对应一种运行环境:x86 CPU\ARM CPU\NPU\windows
sandbox:
  # ---------- x86 CPU 沙箱 ----------
  x86_cpu:
    architecture: x86           # CPU 架构: x86 或 arm64
    accelerator: null           # 加速器类型: null(无)/npu/gpu
    lease_ttl_seconds: 900         # 900s检测沙箱存活
    max_ttl_second: 14400          # 沙箱最大存活时间，大于任务执行时间
    wait_timeout_seconds: 1200   # 等待沙箱就绪的超时时间（秒）

    sandbox:
      image: swr.cn-east-4.myhuaweicloud.com/rl_team/jiuwenswarm:xiaoyi-2026.10.26
      # 环境变量配置
      env:
        - name: PIP_INDEX_URL
          value: https://mirrors.huaweicloud.com/repository/pypi/simple
        - name: PIP_TRUSTED_HOST
          value: mirrors.huaweicloud.com
        - name: NODE_TLS_REJECT_UNAUTHORIZED
          value: '0'
        - name: SERPER_API_KEY
          value: sk-xxxx
        - name: SERPER_API_URL
          value: https://yibuapi.com/serper/
        - name: OPENCLAW_SDK_RETRY_MAX_WAIT_SECONDS
          value: 'off'
        - name: SEARCH_API_KEY
          value: sk-xxxx
        - name: SEARCH_BACKEND_URL
          value: https://yibuapi.com
        - name: DSH_MAX_TOKENS
          value: 131072
        - name: MCP_PLAYWRIGHT
          value: 'on'
        - name: IMAGE_READING
          value: 'on'
        - name: IMAGE_READING_PATH
          value: /home/ma-user/claude_code_image_reading_tool/mcp-image-reading/server.js
        - name: VL_API_URL
          value: http://115.120.87.159:8082/v1
        - name: VL_API_KEY
          value: sk-xxxxx
        - name: VL_MODEL_ID
          value: gemini-3.8-flash


      # 资源请求与限制
      resources:
        cpu_request: "2"          # CPU 请求量（核数）
        cpu_limit: "3"          # CPU 上限（核数）
        memory_request: "6Gi"     # 内存请求量
        memory_limit: "8Gi"       # 内存上限


s3:
  s3_uploader_script: /home/ma-user/obsutil/obsutil
  s3_download_script: /home/ma-user/obsutil/obsutil
  bucket_name: "obs://s3-asset-b-hd-cce-aifm-nlp-exp"

sandbox_id_prefix: zxtestjiuwenswarm
sandbox_namespace: omni-env-default-worker

run_config:
  harness_type: jiuwenswarm-xiaoyi
  harness_md: 
  start_index: 0      # 开始执行任务的索引号，有时候需要跳过部分数据
  total_num: 0      # 任务总数, 0表示不限制任务数量
  concurrent_num: 3   # 并发数 claude 100~150
  sandbox:
    result_log: "run.log"
    openclaw_local_config_file: uploads/jw_xiaoyi_config.yaml
    user_proxy_model_local_file: "uploads/user_proxy_model.json"
    openclaw_start_timeout: 180  # openclaw 镜像版本号大于0.0.6时 设大于60，启动有点慢
  task:
    suffix_api_keys: true # true 对应自部署模型配置user_id，第三方模型置为false
    enable_pip_install: false
    task_input_path: /root/zengxiang/task_configs
    task_output_path: "outputs"  # 任务输出路径
    task_complete_record: "complete.jsonl"  # 完成任务记录文件
    task_failed_record: "failed.jsonl"  # 失败任务记录文件
    task_download_path: "downloads"
    main_code_tar: 
    main_code_dir: /root/zengxiang/openclaw-task
    main_python_file: "harness_automation.py"  # start脚本文件
    main_python_timeout: 15000
  obs:
    download_timeout: 1200
    upload_timeout: 900
    traj_save_bucket: obs://s3-asset-b-hd-cce-aifm-nlp-exp
    traj_save_path: 
    skill_download_path:
    user_config_download_path: 
    user_profile_download_path: 
    agents_download_path: 
    default_skills: