*.pyc

# ===== Platform =====
# 前端
platform/frontend/node_modules/
platform/frontend/dist/

# 后端运行时
platform/platform.db
platform/platform.log
platform/platform.pid
platform/tmp/
platform/configs/
platform/instances/

# obsutil 二进制（太大，各环境自行部署）
platform/obsutil/

# 离线分析缓存 + 沙箱产物缓存（「工作区」tab 的文件字节落在 output_cache/_artifacts/）
platform/output_cache/

# settings 实际配置文件（含密钥，不提交；.example / *_example 提交）
# 单文件实例
platform/settings/config.yaml
platform/settings/openclaw.json
platform/settings/user_proxy_model.json
platform/settings/jw_config.yaml
# 实例化目录：只有模板进 Git（worker 用 *.yaml.example，sandbox 用 *_example.yaml）
platform/settings/worker/*.yaml
!platform/settings/worker/*.example
!platform/settings/worker/*_example.yaml
platform/settings/sandbox/*.yaml
!platform/settings/sandbox/*.example
!platform/settings/sandbox/*_example.yaml
# 运行时派生：由 settings/harness_config.json 派生（见 api/routers/harness_configs.py），
# 迁移备份与按模板展开的 openjiuwen 实例同理
platform/settings/harness/
platform/settings/harness.bak.*/
platform/settings/openjiuwen/

# ===== 运行时状态（进程 / 锁 / 派生缓存）=====
platform/*.pid
platform/*.lock
platform/.res_cache.*.json
platform/.analyze_snapshot.json
# 缓存写入未完成时的 .tmp 中间文件也一并覆盖
platform/analyze_file_state.json.gz*

# ===== 数据库备份 / WAL =====
platform/backup_*.db
platform/*.db-shm
platform/*.db-wal
# 历史遗留的裸 db（hive_output.db 等），已在上方 *.db-shm/-wal 覆盖同名 WAL
platform/hive_output.db

